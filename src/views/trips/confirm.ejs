<%- include('../partials/header') %>

<article class="confirmation-page">
    <div class="confirmation-header">
        <div class="success-icon">
            <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="32" cy="32" r="32" fill="var(--clr-primary)"/>
                <path d="M20 32L28 40L44 24" stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>

        <h1 class="confirmation-title"><%= title %></h1>
        <p class="confirmation-message">
            Your scenic railway journey has been confirmed. Thank you for booking with Kizuna Rail!
        </p>

        <div class="booking-reference">
            <span class="reference-label">Booking Reference</span>
            <span class="reference-number"><%= booking.id %></span>
        </div>
    </div>

    <div class="confirmation-content">
        <section class="booking-details">
            <h2 class="section-title">Booking Details</h2>

            <div class="details-grid">
                <div class="detail-card">
                    <div class="detail-icon">Ticket</div>
                    <div class="detail-content">
                        <span class="detail-label">Ticket Class</span>
                        <span class="detail-value"><%= booking.ticketClass %></span>
                    </div>
                </div>

                <div class="detail-card">
                    <div class="detail-icon">Day</div>
                    <div class="detail-content">
                        <span class="detail-label">Travel Day</span>
                        <span class="detail-value"><%= booking.selectedDay %></span>
                    </div>
                </div>

                <div class="detail-card">
                    <div class="detail-icon">Guests</div>
                    <div class="detail-content">
                        <span class="detail-label">Number of Passengers</span>
                        <span class="detail-value"><%= booking.passengers.length %></span>
                    </div>
                </div>

                <div class="detail-card">
                    <div class="detail-icon">Date</div>
                    <div class="detail-content">
                        <span class="detail-label">Booking Date</span>
                        <span class="detail-value">
                            <%= new Date(booking.createdAt).toLocaleDateString() %>
                        </span>
                    </div>
                </div>
            </div>
        </section>

        <section class="passenger-details">
            <h2 class="section-title">Passenger Information</h2>

            <% booking.passengers.forEach((passenger, index) => { %>
                <div class="detail-card">
                    <div class="detail-content">
                        <h3>Passenger <%= index + 1 %></h3>
                        <p>
                            <strong>Name:</strong>
                            <%= passenger.firstName %> <%= passenger.lastName %>
                        </p>
                        <p>
                            <strong>Email:</strong>
                            <%= passenger.email %>
                        </p>
                        <p>
                            <strong>Phone:</strong>
                            <%= passenger.phone %>
                        </p>
                    </div>
                </div>
            <% }); %>
        </section>

        <div class="confirmation-actions">
            <button type="button" class="btn btn-secondary" onclick="window.print()">
                Print Confirmation
            </button>
            <a href="/trips" class="btn btn-primary">Browse More Trips</a>
        </div>
    </div>
</article>

<%- include('../partials/footer') %>
